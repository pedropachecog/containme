# API keys — set whichever agent you're using
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here

# Git identity (auto-detected from git config if not set)
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# GitHub token for git operations inside the container
# GITHUB_TOKEN=ghp_xxxxx

# Local model server URL (replaces cloud API)
# CONTAINME_API_URL=http://host.docker.internal:8080/v1
